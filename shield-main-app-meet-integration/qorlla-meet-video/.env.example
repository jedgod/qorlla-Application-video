PORT=3000
DATABASE_URL=postgres://qorlla:qorlla_dev_only@localhost:5432/qorlla_meet
JWT_SECRET=replace-with-a-random-64-character-secret
CORS_ORIGIN=http://localhost:3000
# Production requires HTTPS reverse proxy and real TURN credentials.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Must be identical on the main server and Meet server; never expose to browser
QORLLA_BRIDGE_SECRET=replace-with-a-random-secret-at-least-32-chars

# Host credential recovery escrow key (v3.9): DISTINCT from QORLLA_VAULT_KEY. 32 random bytes, base64. Back up securely.
RECOVERY_ESCROW_KEY=

# ---- v3.9.2 hardening ----
# Number of trusted reverse proxies in front of Meet (nginx = 1). 0 = connect directly; X-Forwarded-For is then ignored.
TRUST_PROXY_HOPS=0
# Browser-facing API requests per minute per client; private bridge traffic has its own budget
API_RATE_LIMIT=90
BRIDGE_RATE_LIMIT=1200
# Failed passcode attempts allowed per client+meeting and per meeting within 10 minutes
JOIN_FAIL_PER_CLIENT=8
JOIN_FAIL_PER_MEETING=60
# Non-signalling socket events allowed per connection per 10 seconds
SOCKET_EVENT_BUDGET=40
# Use a least-privilege role (sql/005_app_role.sql) for DATABASE_URL in production, not the database owner/superuser.
