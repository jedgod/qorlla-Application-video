# Copy to .env and fill in values

# Optional: 32-byte hex key for AES-256-GCM encryption at rest
# ENCRYPT_KEY=your32bytehexkeyhere

# SMTP for password reset and verification emails
# Example: smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_FROM=noreply@example.com

# Public base URL of the frontend (required in production)
# Links in emails are built from this, never from the request Host header
PUBLIC_URL=http://localhost:8080

# Port
PORT=3000
