# Qorlla Voice Engine: copy to .env and fill in from your secret store. Never commit .env.
PORT=4600
DATABASE_URL=postgres://qorlla_voice:CHANGE_ME@localhost:5432/qorlla
# PG_SSL=true

# Identity: the Qorlla main app signs short-lived ES256 tokens and publishes its public keys here.
VOICE_JWKS_URL=https://your-qorlla-app.example/.well-known/voice-jwks.json
VOICE_JWT_ISSUER=qorlla-main
VOICE_JWT_AUDIENCE=qorlla-voice

# Exact browser origins allowed to call the API and open the WebSocket (comma separated, https in production).
VOICE_ALLOWED_ORIGIN=https://your-qorlla-app.example

# Server-to-server provisioning of identities/extensions (>= 32 random characters). The main app uses it; browsers never see it.
VOICE_ADMIN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional hardening switches
# VOICE_WS_QUERY_TICKET=off        # accept the ticket ONLY in the Sec-WebSocket-Protocol header, never in the URL
# VOICE_RING_SECONDS=60            # unanswered calls become "missed" after this many seconds (5-600)

# Self-hosted coturn (REST credentials: use-auth-secret / static-auth-secret / realm must match). Leave empty for same-network calls only.
TURN_SHARED_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349?transport=tcp
# Optional self-hosted STUN (no third-party STUN is used by default)
STUN_URL=stun:turn.your-domain.example:3478

# ---- v1.3-v1.5: distributed signaling, reliability, group calls
# Several replicas share ONE PostgreSQL and ONE Redis. Redis only carries delivery between replicas; PostgreSQL is the source of truth.
# Use rediss:// with a password/ACL user outside a private test network. Unset = single instance.
# REDIS_URL=rediss://voice:CHANGE_ME@redis.internal:6380
# VOICE_REQUIRE_TURN=true          # refuse to hand out ICE configuration without a working TURN relay
# VOICE_RELAY_ONLY=true            # force all media through TURN (privacy / strict-network mode)
# VOICE_OUTBOX_MAX_PENDING=5000    # new calls and rooms are refused (503 overloaded) above this backlog of undelivered events
# VOICE_OUTBOX_MAX_AGE_SECONDS=300 # ... or when the oldest undelivered event is older than this
# VOICE_OUTBOX_INTERVAL_MS=500     # safety-net poll of the outbox (events are also delivered immediately after commit)
# VOICE_LEASE_GRACE_SECONDS=120    # a device that stops renewing its lease is dropped from a call/room after this long
# VOICE_EVENT_RETENTION_HOURS=168  # delivered events older than this are deleted; undelivered events are never deleted
# PG_POOL_MAX=10
# VOICE_OUTBOX_PUBLISH_TIMEOUT_MS=5000 # a publish that hangs this long counts as failed and is retried
# VOICE_OUTBOX_MAX_ATTEMPTS=25     # an event failing this often for its own reasons is set aside (still replayable); a Redis outage never counts
# VOICE_API_RATE_PER_MIN=240       # per-account request limit
# VOICE_CALL_RATE_PER_MIN=20       # per-account limit on starting calls and rooms
# VOICE_ADMIN_RATE_PER_MIN=120     # per-IP limit on the server-to-server admin API

# ---- v1.11: group call history retention and privacy
# VOICE_HISTORY_RETENTION_DAYS=365 # ended group calls older than this are deleted (members, stays and timeline). 0 = keep for ever; valid values 7-3650; anything else uses 365. Live calls and legal holds are never deleted.
