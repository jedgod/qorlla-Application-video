# OFF until reviewed and enabled in isolated development/staging.
QORLLA_AI_ENABLED=false
QORLLA_AI_PROVIDER=none
QORLLA_AI_APPROVED_PROVIDERS=selfhosted
QORLLA_AI_SELFHOSTED_OLLAMA=true
QORLLA_AI_SELFHOSTED_URL=http://ollama:11434/v1
QORLLA_AI_SELFHOSTED_MODEL=REPLACE_WITH_INSTALLED_MODEL
QORLLA_AI_OLLAMA_ALLOWED_HOSTS=ollama
QORLLA_AI_OLLAMA_CONCURRENCY=2
QORLLA_AI_OLLAMA_MAX_QUEUE=8
QORLLA_AI_TIMEOUT_MS=30000
QORLLA_AI_ALLOW_PAID_FALLBACK=false
QORLLA_AI_ALLOW_FREE_TIER=false
QORLLA_AI_TEST_ADAPTER_ENABLED=false
# When ready for local test only: set QORLLA_AI_ENABLED=true and QORLLA_AI_PROVIDER=selfhosted
# Also confirm the existing Portal database AI feature flag is enabled for that test workspace.
