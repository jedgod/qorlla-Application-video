# Upstream addresses come from the environment (docker-compose.yml) so no hostname or port is hard-coded in routing rules.
upstream main_upstream   { server ${MAIN_UPSTREAM};   keepalive 16; }
upstream portal_upstream { server ${PORTAL_UPSTREAM}; keepalive 16; }
upstream meet_upstream   { server ${MEET_UPSTREAM};   keepalive 16; }

# One JSON object per request (no query strings: they can carry tokens; no cookies; no bodies).
log_format json_access escape=json '{"ts":"$time_iso8601","remote_addr":"$remote_addr","method":"$request_method","uri":"$uri","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,"upstream_status":"$upstream_status","req_id":"$request_id","host":"$host"}';

# WebSocket upgrade helper
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
