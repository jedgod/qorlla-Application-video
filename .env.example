# Copy to ".env" (same folder as docker-compose.yml) and fill in what you need.
# Everything here is optional; the app runs without any of it.

# The public address of the site. REQUIRED for email links in production (never taken from the
# request's Host header). Use https:// so session cookies are also marked Secure.
PUBLIC_URL=https://qorlla.example.com

# Encrypt stored data at rest (AES-256-GCM). 64 hex characters:  openssl rand -hex 32
# Keep this key somewhere safe and OUTSIDE the data volume: without it the data cannot be read.
ENCRYPT_KEY=
# Only while rotating keys: the previous key (then run scripts/encrypt-data.js rotate)
ENCRYPT_KEY_OLD=

# Outbound email: password reset, address confirmation and mail to outside addresses.
SMTP_URL=smtps://username:password@smtp.example.com:465
SMTP_FROM="Qorlla <no-reply@example.com>"
# Outside emails each account may send per day (accounts need a confirmed email to send any)
MAIL_DAILY_LIMIT=20

# ---- Server ----
# Port the server listens on (the web pages treat 5000 and 8080 as "same server"; other ports need a reverse proxy)
PORT=5000
# Where data files live (default: ./data)
# DATA_DIR=./data

# ---- Chat ----
# Messages kept per chat (50-5000)
CHAT_MAX_MESSAGES=500
# Reminders (/remind): shortest allowed delay in seconds, and how often due ones are checked (milliseconds)
# REMINDER_MIN_SECONDS=30
# REMINDER_TICK_MS=15000

# ---- Qorlla Meet bridge (qorlla-meet-video) ----
# Same random 32+ character value as in qorlla-meet-video/.env. Server-side only; never expose to the browser.
# When set, scheduling a meeting also registers it with Meet (fails closed if Meet is unreachable).
# QORLLA_BRIDGE_SECRET=
# MEET_BASE_URL=http://127.0.0.1:3000

# ---- Main PostgreSQL (Meet sync outbox) ----
# MAIN_DB_PASSWORD=
# Local (non-Docker) run: DATABASE_URL=postgres://qorlla_main:<password>@localhost:5432/qorlla_main
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts host secrets; back it up OUTSIDE the database.
# QORLLA_VAULT_KEY=

# ---- Least-privilege database role + public proxy (v3.9.2) ----
# The web app and sync worker connect as qorlla_app (created by meet-sync/sql/005_roles.sh), not as the bootstrap superuser.
# QORLLA_APP_DB_PASSWORD=
# Public URL of the Meet site, served to qorlla.html via /meet-config.js (e.g. https://meet.example.com/)
# MEET_PUBLIC_URL=
# Host ports for the nginx proxy (defaults shown) and an optional TLS config (deploy/nginx/tls.conf) + certificate directory
# PROXY_MAIN_PORT=8080
# PROXY_MEET_PORT=8081
# PROXY_MAIN_TLS_PORT=8443
# PROXY_MEET_TLS_PORT=8444
# PROXY_TLS_CONF=./deploy/nginx/tls.conf
# PROXY_CERT_DIR=./deploy/certs
# Sync worker timing (defaults are the production values)
# MEET_SYNC_LEASE_SECONDS=90
# MEET_SYNC_BACKOFF_BASE_SECONDS=5
# MEET_SYNC_ACK_BACKOFF_BASE_SECONDS=5
