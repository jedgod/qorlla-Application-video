# Copy to ".env" (same folder as docker-compose.yml) and fill in what you need.
# Everything here is optional; the app runs without any of it.

# The public address of the site. REQUIRED for email links in production (never taken from the
# request's Host header). Use https:// so session cookies are also marked Secure.
PUBLIC_URL=https://qorlla.example.com

# Encrypt stored data at rest (AES-256-GCM). 64 hex characters:  openssl rand -hex 32
# Keep this key somewhere safe and OUTSIDE the data volume: without it the data cannot be read.
ENCRYPT_KEY=
# Only while rotating keys: the previous key (then run scripts/encrypt-data.js rotate)
ENCRYPT_KEY_OLD=

# Outbound email: password reset, address confirmation and mail to outside addresses.
SMTP_URL=smtps://username:password@smtp.example.com:465
SMTP_FROM="Qorlla <no-reply@example.com>"
# Outside emails each account may send per day (accounts need a confirmed email to send any)
MAIL_DAILY_LIMIT=20

# ---- Server ----
# Port the server listens on (the web pages treat 5000 and 8080 as "same server"; other ports need a reverse proxy)
PORT=5000
# Where data files live (default: ./data)
# DATA_DIR=./data

# ---- Chat ----
# Messages kept per chat (50-5000)
CHAT_MAX_MESSAGES=500
# Reminders (/remind): shortest allowed delay in seconds, and how often due ones are checked (milliseconds)
# REMINDER_MIN_SECONDS=30
# REMINDER_TICK_MS=15000
