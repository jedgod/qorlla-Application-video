# Copy to .env on the staging VPS ONLY. Contains hostnames and addresses, no secrets. The TURN shared secret is a separate file (./secrets/turn_shared_secret).
# The hostnames below are PROPOSALS, not active endpoints: use hostnames in a domain you control and have pointed at the VPS (README.md step 2).
MEET_HOST=meet.staging.REPLACE-WITH-YOUR-DOMAIN
APP_HOST=app.staging.REPLACE-WITH-YOUR-DOMAIN
TURN_HOST=turn.staging.REPLACE-WITH-YOUR-DOMAIN
TURN_EXTERNAL_IP=REPLACE-WITH-THE-VPS-PUBLIC-IPV4
# Upstreams reachable from the proxy over a PRIVATE network or loopback (never the public internet).
QORLLA_MEET_UPSTREAM=127.0.0.1:3310
QORLLA_APP_UPSTREAM=127.0.0.1:5290
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
