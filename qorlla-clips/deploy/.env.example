# Production settings for the Clips stack (copy to .env on the server; never commit it).
CLIPS_IMAGE_REPO=ghcr.io/your-org/your-repo          # lowercase
IMAGE_TAG=latest                                       # the deploy job sets this to the commit it deploys
POSTGRES_PASSWORD=

AUTH_MODE=qorlla
QORLLA_MAIN_URL=https://your-qorlla-host
ORG_SLUG=default
ORG_NAME=Qorlla
ADMIN_USERNAMES=
# the public origin the browser uses for the web app (also the cross-site allow-list)
CORS_ORIGINS=https://your-qorlla-host

# Object storage (AWS S3 or compatible)
S3_REGION=us-east-1
S3_BUCKET=your-clips-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# leave S3_ENDPOINT empty for AWS; set it (and S3_FORCE_PATH_STYLE=1) for MinIO or other S3-compatible stores
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=0
