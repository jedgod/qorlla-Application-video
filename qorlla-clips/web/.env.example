# Where the Next.js server forwards /api/* (the Clips API)
CLIPS_API_URL=http://127.0.0.1:5400
# Mount the app under a path of the main site (build time), e.g. /clips
# CLIPS_BASE_PATH=/clips
# The main Qorlla app, if it is on another origin (default: same origin)
# NEXT_PUBLIC_MAIN_URL=
# Local development only: names the caller when the API runs with AUTH_MODE=dev
# NEXT_PUBLIC_DEV_USER=casey@example.com
# NEXT_PUBLIC_DEV_ORG=default
# NEXT_PUBLIC_DEV_ROLE=admin
