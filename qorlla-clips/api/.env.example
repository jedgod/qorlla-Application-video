# --- Database: the provider is chosen from the URL scheme -------------------------------------------------------------------
# PostgreSQL (production):
DATABASE_URL="postgresql://clips:change-me@localhost:5432/qorlla_clips"
# SQLite (local files and tests only; refused when NODE_ENV=production):
# DATABASE_URL="file:./dev.db"

PORT=5400
NODE_ENV=development

# --- Identity ---------------------------------------------------------------------------------------------------------------
# qorlla: the browser's Qorlla session cookie is verified against the main app on every request (the production default).
# dev:    the x-dev-user header names the caller. Local work and tests only; refused when NODE_ENV=production.
AUTH_MODE=dev
QORLLA_MAIN_URL=http://localhost:3200
# one organization per deployment until the main app has an organization model
ORG_SLUG=default
ORG_NAME=Qorlla
# Qorlla usernames (comma separated) that administer organization playlists
ADMIN_USERNAMES=

# --- Network / safety -------------------------------------------------------------------------------------------------------
# Browsers reach the API through the Next.js server (same origin), so CORS is normally not needed. List origins only if you must.
CORS_ORIGINS=
# 1 only when the API is reachable ONLY through your proxy (nginx / the Next.js server): the browser's host is then taken from
# X-Forwarded-Host for the cross-site check. Otherwise list the web app's public origin in CORS_ORIGINS.
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=600

# --- Media pipeline (service-to-service) -------------------------------------------------------------------------------------
# Leave SERVICE_KEY empty to disable POST /api/internal/clips/:id/complete. Set it (40+ random chars) when a worker attaches media.
SERVICE_KEY=
MEDIA_HOSTS=

# --- Video storage (S3 or compatible) ---------------------------------------------------------------------------------------
# Without these, recording/upload endpoints answer 503 "storage_unavailable"; everything else works.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty for AWS. For MinIO or another S3-compatible store set it, and S3_FORCE_PATH_STYLE=1.
S3_ENDPOINT=
# The address BROWSERS use to reach the store (signed upload/playback links point here). Defaults to S3_ENDPOINT.
# Needed when the API reaches the store at a private address (http://minio:9000) the browser cannot.
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=0
# server-side encryption for new objects: AES256 or aws:kms (leave empty for the store's default)
S3_SSE=
# development only (refused in production): create the bucket at start-up
S3_AUTO_CREATE_BUCKET=0
# part size in MB (minimum 5) and the largest accepted file; parts x size must stay under the 10000-part limit
UPLOAD_PART_MB=8
MAX_UPLOAD_MB=2048
# unfinished uploads older than this are aborted and marked Failed
UPLOAD_TTL_HOURS=24
# how long a playback link stays valid
PLAYBACK_URL_SECONDS=900
