// Qorlla Clips - data model.
//
// PROVIDER: this file is committed with "postgresql" (production). For lightweight local runs/tests use SQLite:
//   DATABASE_URL="file:./dev.db" npm run db:push        (the scripts pick the provider from the URL scheme and generate the
//   matching client from a copy of this file; this file itself is never edited by a script)
//
// MULTI-TENANCY: every row belongs to exactly one Organization, and every query in the API is scoped by it. A user in one
// organization can never see, share to, or list anything in another.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ClipSource {
  RECORDING
  AVATAR_GENERATION
  SLIDE_CONVERSION
  UPLOAD
  QORLLA_MEETING
}

// A clip is created first and becomes READY only when its media exists. No placeholder URL is ever stored.
//   UPLOADING   a browser recording is being uploaded to object storage
//   PROCESSING  waiting for a media worker (avatars, slides)
enum ClipStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum OrgRole {
  MEMBER
  ADMIN
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  // "free" accounts have the Upload video action locked; any other plan unlocks it
  plan      String     @default("free")
  users     User[]
  clips     Clip[]
  avatarDrafts AvatarDraft[]
  playlists Playlist[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id             String         @id @default(uuid())
  // the account id in the identity provider (the Qorlla main app); unique so one login maps to one user
  externalId     String?        @unique
  email          String         @unique
  name           String?
  role           OrgRole        @default(MEMBER)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clips          Clip[]
  avatarDrafts   AvatarDraft[]
  playlists      Playlist[]
  shares         ClipShare[]
  notifications  Notification[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
}

model Playlist {
  id             String       @id @default(uuid())
  title          String
  // organization playlists are visible to every member of the SAME organization and managed by its admins
  isOrganization Boolean      @default(false)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clips          Clip[]       @relation("PlaylistToClip")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isOrganization])
  @@index([ownerId])
}

model Clip {
  id             String       @id @default(uuid())
  title          String
  // external media (set by a worker); recordings use storageKey instead and are played through a signed link
  videoUrl       String?
  // recordings: the object in storage (built by the SERVER from ids, never from user input) and its multipart upload
  storageKey     String?      @unique
  uploadId       String?
  sizeBytes      BigInt?
  partSize       Int?
  mimeType       String?
  durationMs     Int?
  // the meeting id when a clip was ingested from Qorlla Meeting (unique per organization: a repeat delivery finds the same clip)
  externalId     String?
  source         ClipSource   @default(RECORDING)
  status         ClipStatus   @default(PROCESSING)
  isStarred      Boolean      @default(false)
  isTrashed      Boolean      @default(false)
  trashedAt      DateTime?
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlists      Playlist[]   @relation("PlaylistToClip")
  shares         ClipShare[]
  views          PlaybackEvent[]
  reports        ClipReport[]
  avatarDraft    AvatarDraft?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, ownerId, isTrashed, updatedAt])
  @@index([ownerId, isStarred])
  @@unique([organizationId, externalId])
}

// "Shared with me": one row per (clip, recipient)
model ClipShare {
  id        String   @id @default(uuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clipId, userId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  clipId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// One row each time someone is given a playback link for a clip (the only "view" signal that really exists; watch time is not measured).
model PlaybackEvent {
  id             String   @id @default(uuid())
  clipId         String
  clip           Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  organizationId String
  viewerId       String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([clipId])
}

// A member reports a clip they can see; an organization admin reviews it. status: OPEN, DISMISSED, ACTIONED (clip moved to trash).
model ClipReport {
  id             String    @id @default(uuid())
  clipId         String
  clip           Clip      @relation(fields: [clipId], references: [id], onDelete: Cascade)
  organizationId String
  reporterId     String
  reason         String
  status         String    @default("OPEN")
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([clipId, reporterId])
  @@index([organizationId, status, createdAt])
}

// Append-only record of administrative decisions. The clip may be deleted later, so no foreign key.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  clipId         String?
  detail         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ---- Avatars ---------------------------------------------------------------------------------------------------------------------
// Subscription tiers for pre-built avatars. The tier a person may use comes from their ORGANIZATION'S PLAN (see src/avatars.js), never
// from their role: an admin of a free organization does not get paid avatars.
// Same names as the plans, lowest to highest. A plan unlocks its own tier and every tier below it.
enum AvatarTier {
  BASIC
  PRO
  BUSINESS
  ENTERPRISE
}

// Immutable reference catalog. No API writes it; only scripts/seed-avatars.mjs inserts rows, and never changes one that exists.
// A look that changes is a NEW row (new slug), so a draft always points at exactly the avatar it was made with.
model InbuiltAvatar {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  thumbnailUrl String?
  // key of the reference media in the media worker's store; never sent to browsers
  modelKey     String
  tier         AvatarTier    @default(BASIC)
  drafts       AvatarDraft[]
  createdAt    DateTime      @default(now())
}

// A draft made with a pre-built avatar. It lives ONLY here (the Avatars workspace). It becomes a Clip, and appears in My Clips, only
// when its owner explicitly promotes it; promotedClipId is then the link and the draft can never be promoted twice.
model AvatarDraft {
  id             String        @id @default(uuid())
  title          String
  // what the presenter is to say (optional, up to 1000 characters); it goes to the media worker, never into a Clip
  script         String?
  avatarId       String
  avatar         InbuiltAvatar @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  status         ClipStatus    @default(PROCESSING)
  // set by the media worker (https, allow-listed host) when the render is READY
  videoUrl       String?
  // a render made by our own media worker lives in object storage under a key the SERVER builds (see draftObjectKey); promoting
  // the draft hands the same object to the new Clip
  storageKey     String?       @unique
  sizeBytes      BigInt?
  mimeType       String?
  // length of the render, reported by the media worker and capped by the avatar's tier (see TIER_MAX_SECONDS)
  durationMs     Int?
  isPromoted     Boolean       @default(false)
  promotedClipId String?       @unique
  promotedClip   Clip?         @relation(fields: [promotedClipId], references: [id], onDelete: SetNull)
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([ownerId, organizationId, isPromoted])
}
