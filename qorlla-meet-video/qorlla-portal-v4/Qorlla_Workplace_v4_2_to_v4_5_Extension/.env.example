PORT=5500
DATABASE_URL=postgres://qorlla:change-me@localhost:5432/qorlla
NODE_ENV=production
# Public HTTPS origin used by browsers; no trailing slash.
PORTAL_ALLOWED_ORIGIN=https://qorlla.example.com
# MAIN's exact OIDC-style issuer and public JWKS endpoint.
MAIN_AUTH_ISSUER=https://qorlla.example.com
MAIN_AUTH_JWKS_URL=https://qorlla.example.com/.well-known/jwks.json
PORTAL_AUTH_AUDIENCE=qorlla-workplace
# Configure MAIN to issue the secure cookie described in INTEGRATION.md.
