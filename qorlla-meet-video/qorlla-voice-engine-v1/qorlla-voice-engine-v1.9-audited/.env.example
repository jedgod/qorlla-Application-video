PORT=4600
DATABASE_URL=postgres://qorlla_voice:CHANGE_ME@localhost:5432/qorlla
VOICE_JWKS_URL=https://your-qorlla-auth.example/.well-known/jwks.json
VOICE_JWT_ISSUER=https://your-qorlla-auth.example
VOICE_JWT_AUDIENCE=qorlla-voice
VOICE_ALLOWED_ORIGIN=https://your-qorlla-app.example
TURN_SHARED_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349?transport=tcp
STUN_URL=stun:turn.your-domain.example:3478

# Required for distributed signaling; use rediss:// outside private test networks
REDIS_URL=redis://localhost:6379
