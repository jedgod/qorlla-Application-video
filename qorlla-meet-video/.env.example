PORT=3000
DATABASE_URL=postgres://qorlla:qorlla_dev_only@localhost:5432/qorlla_meet
JWT_SECRET=replace-with-a-random-64-character-secret
CORS_ORIGIN=http://localhost:3000
# Production requires HTTPS reverse proxy and real TURN credentials.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# Must be identical on the main server and Meet server; never expose to browser
QORLLA_BRIDGE_SECRET=replace-with-a-random-secret-at-least-32-chars

# Host credential recovery escrow key (v3.9): DISTINCT from QORLLA_VAULT_KEY. 32 random bytes, base64. Back up securely.
RECOVERY_ESCROW_KEY=
