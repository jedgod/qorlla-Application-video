VOICE_INTERNAL_CALLS_ENABLED=true
VOICE_NUMBERS_ENABLED=false
VOICE_PSTN_ENABLED=false
VOICE_MEDIA_POLICY=relay
PORT=8443
DATABASE_URL=postgresql://REPLACE_WITH_SECRET@db.example.internal:5432/qorlla
PG_SSL=true
REDIS_URL=rediss://redis.example.internal:6379
TLS_KEY=/run/secrets/voice-server.key
TLS_CERT=/run/secrets/voice-server.crt
TLS_CLIENT_CA=/run/secrets/workload-ca.crt
WORKLOAD_JWKS_URL=https://issuer.example.internal/.well-known/jwks.json
WORKLOAD_ISSUER=https://issuer.example.internal/
WORKLOAD_AUDIENCE=qorlla-voice
WORKLOAD_ALLOWLIST=[{"sub":"numbers-plans-workload","scopes":["voice.account.suspend"]}]
QORLLA_SHIELD_ADAPTER=/absolute/path/to/your/shield-adapter.mjs
